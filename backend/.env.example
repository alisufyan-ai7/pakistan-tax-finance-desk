# Local synthetic-data development ONLY; do not use real bank statements.
OWNER_USERNAME=owner
# Set a unique random password with at least 16 characters, never commit it.
OWNER_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_LOCAL_SECRET
# Use absolute path or run from backend directory.
DATABASE_URL=sqlite:///./data/finance.db
# M2 synthetic-only encrypted historical filing fixtures. DO NOT use real returns.
# Generate a fresh 32-byte key locally, e.g.:
# python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
DOCUMENT_VAULT_KEY=
DOCUMENT_VAULT_DIR=./data/evidence

# M2b: explicit demo-mode safety gate; setting APP_DATA_MODE=real refuses to start.
APP_DATA_MODE=synthetic
# Independent, random 32-byte backup encryption key; do not reuse vault key.
# Generate locally: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
BACKUP_KEY=
# M2d: field-level AES-GCM envelope keyring. Generate a UNIQUE 32-byte
# key per key id and store outside the repository; no default/fallback key.
# Example (replace placeholder with random base64 from the command above):
# LEDGER_FIELD_KEYS_JSON='{"local_v1":"BASE64URL_OF_RANDOM_32_BYTES"}'
# LEDGER_FIELD_ACTIVE_KEY=local_v1
# Never use synthetic test keys for real data. Migration 0003 required.
# The synthetic app still rejects real financial data.
# Real personal financial records are not supported by M2d.

# Optional synthetic-only MFA session gateway (still local/HTTPS only).
# OWNER_AUTH_MODE=totp_session
# Configure a unique scrypt hash and base32 TOTP seed securely OUTSIDE source control.
# OWNER_PASSWORD_SCRYPT=
# OWNER_TOTP_SECRET=
# Do not run this gateway for genuine bank/FBR data until production security is certified.

# M2i dedicated 32-byte HMAC key for statement/transaction dedup blind indexes.
# Generate a RANDOM independent key; DO NOT reuse encryption, backup or test keys.
# LEDGER_DEDUP_HMAC_KEY=<base64url-of-32-random-bytes>
# Changing this requires an audited offline rebuild. Never store real data here yet.
